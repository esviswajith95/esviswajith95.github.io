---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { readingTime } from '../lib/format';

interface Props {
  entry: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { entry, prev, next } = Astro.props;
const { title, description, outcome, sector, role, period, stack, metric } = entry.data;
const minutes = readingTime(entry.body ?? '');
---

<Base title={title} description={description} og={`project-${entry.id}`} type="article">
  <article>
    <header class="page-head column">
      <span class="eyebrow">Project · {minutes} min read</span>
      <h1>{title}</h1>
      <dl class="meta-row">
        <div>
          <dt class="meta">Client</dt>
          <dd>{sector}</dd>
        </div>
        <div>
          <dt class="meta">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="meta">Period</dt>
          <dd>{period}</dd>
        </div>
        <div class="stack">
          <dt class="meta">Stack</dt>
          <dd>
            <ul class="tags">{stack.map((s) => <li class="chip">{s}</li>)}</ul>
          </dd>
        </div>
      </dl>
    </header>

    <div class="column">
      <aside class="outcome" aria-label="Outcome">
        <p class="figure">{metric.value}</p>
        <div>
          <span class="eyebrow">Outcome</span>
          <p class="sentence">{outcome}</p>
        </div>
      </aside>

      <div class="prose">
        <slot />
      </div>
    </div>

    <nav class="band pager" aria-label="More projects">
      {
        prev ? (
          <a class="prev" href={`/projects/${prev.id}/`}>
            <span class="meta">Previous</span>
            <span class="t">{prev.data.title}</span>
          </a>
        ) : (
          <a class="prev" href="/projects/">
            <span class="meta">Back</span>
            <span class="t">All projects</span>
          </a>
        )
      }
      {
        next ? (
          <a class="next" href={`/projects/${next.id}/`}>
            <span class="meta">Next</span>
            <span class="t">{next.data.title}</span>
          </a>
        ) : (
          <a class="next" href="/">
            <span class="meta">Next</span>
            <span class="t">Résumé and contact</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .page-head {
    padding-bottom: var(--space-5);
  }

  .meta-row {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .meta-row dd {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
  }

  .stack {
    grid-column: 1 / -1;
  }

  .stack .tags {
    margin-top: 0.375rem;
  }

  .outcome {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: var(--surface);
    border-left: 2px solid var(--accent);
  }

  .figure {
    margin: 0;
    font-family: var(--serif);
    font-size: calc(var(--fs-metric) * 0.75);
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  .outcome .eyebrow {
    margin-bottom: var(--space-1);
  }

  .sentence {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .prose {
    padding-bottom: var(--space-8);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--section);
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--ink);
  }

  .pager a:hover .t {
    color: var(--accent);
    text-decoration: underline;
  }

  .next {
    text-align: right;
  }

  .t {
    font-family: var(--serif);
    font-size: var(--fs-h3);
    line-height: 1.25;
  }

  @media (max-width: 720px) {
    .meta-row {
      grid-template-columns: 1fr 1fr;
    }

    .outcome {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-3);
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .next {
      text-align: left;
    }
  }
</style>
