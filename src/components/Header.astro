---
import { SITE } from '../config';

const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="band inner">
    <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch colour theme" hidden>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector('.theme-toggle');
    if (!button) return;
    const root = document.documentElement;
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const current = () => root.dataset.theme || (dark.matches ? 'dark' : 'light');
    const sync = () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      button.dataset.current = current();
      button.setAttribute('aria-label', `Switch to ${next} theme`);
    };
    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
      sync();
    });
    dark.addEventListener('change', sync);
  })();
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 72px;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--transition);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--ink);
  }

  .icon-sun,
  .theme-toggle[data-current='dark'] .icon-moon {
    display: none;
  }

  .theme-toggle[data-current='dark'] .icon-sun {
    display: block;
  }

  @media (max-width: 560px) {
    .inner {
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: var(--space-2);
    }

    .wordmark {
      order: 1;
    }

    .theme-toggle {
      order: 2;
    }

    nav {
      order: 3;
      width: 100%;
    }

    nav ul {
      justify-content: space-between;
      gap: var(--space-2);
    }
  }
</style>
